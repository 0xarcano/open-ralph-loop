{
  "name": "open-ralph-loop",
  "version": "0.1.0",
  "description": "OpenCode-native Ralph Loop plugin for Lisa PRDs",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "commands/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ralph-loop",
    "lisa",
    "ai-agent"
  ],
  "author": "0xarcano <prodasl@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/0xarcano/open-ralph-loop.git"
  },
  "bugs": {
    "url": "https://github.com/0xarcano/open-ralph-loop/issues"
  },
  "homepage": "https://github.com/0xarcano/open-ralph-loop#readme",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
